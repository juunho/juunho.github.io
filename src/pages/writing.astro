---
import Base from '../layouts/Base.astro';
import WritingList from '../components/WritingList.astro';
import { count, getWriting } from '../lib/writing';

const entries = await getWriting();

const internal = entries.filter((e) => !e.external).length;
const external = entries.length - internal;
---

<Base
  title="Writing"
  description="Posts by juunho — written here and elsewhere."
>
  <div class="page page--narrow">
    <header class="head">
      <h1 class="display">Writing</h1>
      <p class="note">
        {count(internal, 'post')} here, {external} elsewhere.
        <span class="arrow" aria-hidden="true">↗</span> marks a link that
        leaves this site.
      </p>
    </header>

    {/*
      외부 글은 본문이 없어서 개별 페이지가 없습니다. 이 목록을 인덱싱해야
      제목·메모로도 검색에 걸립니다.
    */}
    <div data-pagefind-body>
      <WritingList entries={entries} showDescription />
    </div>
  </div>
</Base>

<style>
  .head {
    padding: 3rem 0 1.75rem;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 2.75rem);
  }

  .note {
    margin: 1rem 0 0;
    color: var(--dim);
    font-size: 0.875rem;
    max-width: 46ch;
  }

  .arrow {
    color: var(--acc);
  }
</style>
