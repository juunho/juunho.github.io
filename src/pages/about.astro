---
import Base from '../layouts/Base.astro';
import { SITE, SOCIAL } from '../consts';
---

<Base title="About" description={SITE.description}>
  <div class="page page--narrow">
    <header class="head">
      <h1 class="display">About</h1>
    </header>

    <div class="prose">
      <p>{SITE.bio}</p>

      <p>
        Most of my time goes to search quality: fine-tuning embedding models
        for a domain, deciding how lexical search and dense retrieval should
        share the work, and making the result run within budget.
      </p>

      <p>
        I write here when something is worth keeping. Posts published
        elsewhere are collected on the <a href="/writing/">writing</a> page
        as well.
      </p>

      <h2>Elsewhere</h2>
      <ul>
        {
          SOCIAL.map((item) => (
            <li>
              <a
                href={item.href}
                target={item.href.startsWith('http') ? '_blank' : undefined}
                rel={
                  item.href.startsWith('http')
                    ? 'noopener noreferrer'
                    : undefined
                }
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Base>

<style>
  .head {
    padding: 3rem 0 1.75rem;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 2.75rem);
  }
</style>
