---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getSiteCopy } from '../lib/site';

const copy = await getSiteCopy();
const page = await getEntry('pages', 'about');
if (!page) {
  throw new Error('src/content/pages/about.md 가 없습니다.');
}
const { Content } = await render(page);
---

<Base title={page.data.title} description={copy.description}>
  <div class="page page--narrow">
    <header class="head">
      <h1 class="display">{page.data.title}</h1>
    </header>

    <div class="prose">
      <Content />

      <h2>Elsewhere</h2>
      <ul>
        {
          copy.social.map((item) => (
            <li>
              <a
                href={item.href}
                target={item.href.startsWith('http') ? '_blank' : undefined}
                rel={
                  item.href.startsWith('http')
                    ? 'noopener noreferrer'
                    : undefined
                }
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Base>

<style>
  .head {
    padding: 3rem 0 1.75rem;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 2.75rem);
  }
</style>
