---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  /** 페이지 언어. 글은 frontmatter 의 lang 을 넘깁니다. 기본은 사이트 언어. */
  lang?: string;
}

const { lang = SITE.lang, ...head } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead {...head} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
