---
import { formatDate, type WritingEntry } from '../lib/writing';

interface Props {
  entries: WritingEntry[];
  /** 요약문을 함께 보여줄지. 홈에서는 끄고, /writing 에서는 켭니다. */
  showDescription?: boolean;
}

const { entries, showDescription = false } = Astro.props;
---

<ul class="writing">
  {
    entries.map((entry) => (
      <li>
        <a
          href={entry.href}
          target={entry.external ? '_blank' : undefined}
          rel={entry.external ? 'noopener noreferrer' : undefined}
        >
          <time datetime={entry.date.toISOString()}>
            {formatDate(entry.date)}
          </time>

          <span class="body">
            <span class="title underline-grow">{entry.title}</span>
            {showDescription && entry.description && (
              <span class="desc">{entry.description}</span>
            )}
          </span>

          {entry.external ? (
            <span class="ext">
              <span aria-hidden="true" class="arrow">
                ↗
              </span>
              {entry.source}
              <span class="sr-only">(외부 링크, 새 탭에서 열림)</span>
            </span>
          ) : (
            <span class="tg">{entry.tags[0]}</span>
          )}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .writing {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  li {
    border-bottom: 1px solid var(--rule);
  }

  a {
    display: grid;
    grid-template-columns: 5.25rem 1fr auto;
    gap: 1.25rem;
    align-items: baseline;
    padding: 1.0625rem 0;
  }

  time {
    font-family: var(--mono);
    font-size: 0.688rem;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-width: 0;
  }

  .title {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.063rem;
    line-height: 1.4;
    letter-spacing: -0.015em;
    /* 밑줄이 글자 폭만큼만 그려지도록 */
    align-self: flex-start;
  }

  .desc {
    font-size: 0.844rem;
    color: var(--dim);
    line-height: 1.6;
    max-width: 52ch;
  }

  .tg,
  .ext {
    font-family: var(--mono);
    font-size: 0.625rem;
    color: var(--dim);
    white-space: nowrap;
  }

  .ext {
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
  }

  .arrow {
    color: var(--acc);
    font-size: 0.688rem;
    display: inline-block;
    transition: transform 0.2s ease;
  }
  a:hover .arrow {
    transform: translate(1px, -1px);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 34rem) {
    a {
      grid-template-columns: 1fr auto;
      gap: 0.375rem 0.75rem;
      padding: 0.9375rem 0;
    }
    time {
      grid-column: 1;
    }
    .tg,
    .ext {
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
    }
    .body {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
